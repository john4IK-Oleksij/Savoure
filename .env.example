# ==============================================================================
# Savoure Restaurant — Environment Configuration
# ==============================================================================

# Set to False in production
DEBUG=True

# Unique secret key for production (generate with: python -c 'import secrets; print(secrets.token_urlsafe(50))')
SECRET_KEY=change-me-to-a-secure-random-key-in-production

# Comma-separated list of host/domain names that this Django site can serve
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,.railway.app

# Comma-separated list of trusted origins for unsafe requests (POST, PUT)
CSRF_TRUSTED_ORIGINS=https://*.railway.app,http://127.0.0.1:8000
